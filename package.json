{
  "name": "agent-workflow-engine",
  "version": "1.0.0",
  "description": "Typed, registry-driven multi-agent workflow engine: DSL v1 (data edges, condition, loop), Rete.js editor, run monitor, MCP server",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p .",
    "demo": "tsx scripts/run-demo.ts",
    "validate": "tsx scripts/validate.ts",
    "plan": "tsx scripts/plan-demo.ts",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "server": "tsx scripts/server.ts",
    "dev": "tsx scripts/server.ts & npm --prefix web run dev; kill %1",
    "start": "npm --prefix web run build && tsx scripts/server.ts",
    "convert": "tsx scripts/convert.ts",
    "mcp": "tsx src/mcp/stdio.ts",
    "mcp:demo": "tsx scripts/mcp-demo.ts",
    "test:v1": "vitest run --exclude \"test/advanced/**\"",
    "test:advanced": "vitest run test/advanced"
  },
  "keywords": [
    "agents",
    "workflow",
    "dag",
    "rete",
    "mcp",
    "llm"
  ],
  "author": "GallonShih",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.310",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ajv": "^8.20.0",
    "fastify": "^5.12.7",
    "jsonata": "^2.2.2",
    "rete": "^2.0.6",
    "rete-engine": "^2.1.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/GallonShih/agent-workflow-engine.git"
  }
}
