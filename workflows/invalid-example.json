{
  "version": 1,
  "id": "invalid-example",
  "name": "故意寫錯的 v1 workflow：展示 compiler 會擋下哪些錯（每個錯誤都附修正建議）",
  "nodes": [
    { "id": "start", "type": "start", "ports": { "outputs": { "request": { "type": "string" }, "count": { "type": "integer" } } } },
    { "id": "planner", "type": "planning_agent", "config": { "allowed_tools": ["Bash"], "model": "claude-opus-4" } },
    { "id": "coder", "type": "coding_agent" },
    { "id": "ghost", "type": "web_scraper_agent" },
    { "id": "gate", "type": "condition", "config": { "rule": { "op": "approx", "value": 1 } } },
    { "id": "loop", "type": "loop", "config": { "max_iterations": 0 }, "body": { "nodes": [], "edges": [] } }
  ],
  "edges": [
    "start.count -> planner.request",
    "planner.success -> coder.execute",
    "planner.plan -> coder.nonexistent",
    "coder.summary -> planner.repository",
    "start.request -> gate"
  ]
}
