{
  "version": 1,
  "id": "plan-subflow",
  "name": "子流程：分析需求並拆解任務（給其他 workflow 以 subflow 引用）",
  "nodes": [
    {
      "id": "start",
      "type": "start",
      "ports": {
        "outputs": {
          "request": {
            "type": "string"
          },
          "repository": {
            "type": "string"
          }
        }
      }
    },
    {
      "id": "planner",
      "type": "planning_agent",
      "label": "Planning Agent"
    },
    {
      "id": "end",
      "type": "end",
      "label": "回傳計畫",
      "config": {
        "status": "success"
      },
      "ports": {
        "inputs": {
          "plan": {
            "type": "string"
          },
          "tasks": {
            "type": "array",
            "items": {
              "$type": "Task"
            }
          },
          "acceptance_criteria": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  ],
  "edges": [
    "start.request -> planner.request",
    "start.repository -> planner.repository",
    "planner.plan -> end.plan",
    "planner.tasks -> end.tasks",
    "planner.acceptance_criteria -> end.acceptance_criteria"
  ]
}
