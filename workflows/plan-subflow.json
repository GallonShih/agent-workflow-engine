{
  "id": "plan-subflow",
  "name": "子流程：分析需求並拆解任務（給其他 workflow 以 subflow 引用）",
  "nodes": [
    {
      "id": "start",
      "type": "start",
      "ports": {
        "outputs": {
          "request": {
            "type": "string"
          },
          "repository": {
            "type": "string"
          }
        }
      }
    },
    {
      "id": "planner",
      "type": "planning_agent",
      "label": "Planning Agent"
    },
    {
      "id": "end",
      "type": "end",
      "label": "回傳計畫",
      "config": {
        "status": "success"
      },
      "ports": {
        "inputs": {
          "plan": {
            "type": "string"
          },
          "tasks": {
            "type": "array",
            "items": {
              "$type": "Task"
            }
          },
          "acceptance_criteria": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  ],
  "edges": [
    {
      "kind": "control",
      "from": {
        "node": "start",
        "port": "success"
      },
      "to": {
        "node": "planner",
        "port": "execute"
      }
    },
    {
      "kind": "data",
      "from": {
        "node": "start",
        "port": "request"
      },
      "to": {
        "node": "planner",
        "port": "request"
      }
    },
    {
      "kind": "data",
      "from": {
        "node": "start",
        "port": "repository"
      },
      "to": {
        "node": "planner",
        "port": "repository"
      }
    },
    {
      "kind": "control",
      "from": {
        "node": "planner",
        "port": "success"
      },
      "to": {
        "node": "end",
        "port": "execute"
      }
    },
    {
      "kind": "data",
      "from": {
        "node": "planner",
        "port": "plan"
      },
      "to": {
        "node": "end",
        "port": "plan"
      }
    },
    {
      "kind": "data",
      "from": {
        "node": "planner",
        "port": "tasks"
      },
      "to": {
        "node": "end",
        "port": "tasks"
      }
    },
    {
      "kind": "data",
      "from": {
        "node": "planner",
        "port": "acceptance_criteria"
      },
      "to": {
        "node": "end",
        "port": "acceptance_criteria"
      }
    }
  ]
}