{
  "version": 1,
  "id": "fix-until-tests-pass",
  "name": "分析需求 → 修改程式 → 測試，失敗就帶著回饋重試（最多 3 輪）",
  "nodes": [
    {
      "id": "start",
      "type": "start",
      "ports": {
        "outputs": {
          "request": {
            "type": "string"
          },
          "repository": {
            "type": "string"
          }
        }
      }
    },
    {
      "id": "planner",
      "type": "planning_agent",
      "label": "Planning Agent"
    },
    {
      "id": "risk",
      "type": "risk_review_agent",
      "label": "Risk Review Agent"
    },
    {
      "id": "fix_loop",
      "type": "loop",
      "label": "Coding ⇄ Testing Loop",
      "ports": {
        "inputs": {
          "tasks": {
            "type": "array",
            "items": {
              "$type": "Task"
            }
          },
          "acceptance_criteria": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "feedback": {
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "required": false,
            "default": []
          }
        },
        "outputs": {
          "passed": {
            "type": "boolean"
          },
          "failures": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "summary": {
            "type": "string"
          },
          "files_modified": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "report": {
            "type": "string"
          },
          "feedback": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "config": {
        "max_iterations": 3,
        "until": {
          "port": "passed",
          "op": "eq",
          "value": true
        }
      },
      "body": {
        "nodes": [
          {
            "id": "loop_in",
            "type": "loop_in"
          },
          {
            "id": "coder",
            "type": "coding_agent",
            "label": "Coding Agent"
          },
          {
            "id": "tester",
            "type": "testing_agent",
            "label": "Testing Agent"
          },
          {
            "id": "loop_out",
            "type": "loop_out"
          }
        ],
        "edges": [
          "loop_in.tasks -> coder.tasks",
          "loop_in.feedback -> coder.feedback",
          "loop_in.acceptance_criteria -> tester.acceptance_criteria",
          "coder.files_modified -> tester.files_modified",
          "coder.files_modified -> loop_out.files_modified",
          "coder.summary -> loop_out.summary",
          "tester.passed -> loop_out.passed",
          "tester.failures -> loop_out.failures",
          "tester.report -> loop_out.report",
          "tester.failures -> loop_out.feedback"
        ]
      }
    },
    {
      "id": "gate",
      "type": "condition",
      "label": "PASS / FAIL",
      "config": {
        "rule": {
          "op": "eq",
          "value": true
        }
      }
    },
    {
      "id": "headline",
      "type": "template",
      "ports": {
        "inputs": {
          "iterations": {
            "type": "integer"
          },
          "summary": {
            "type": "string"
          },
          "gate_true": {
            "schema": {},
            "required": false
          }
        }
      },
      "config": {
        "template": "第 {{inputs.iterations}} 輪測試通過：{{inputs.summary}}"
      }
    },
    {
      "id": "report",
      "type": "report_agent",
      "label": "Report Agent"
    },
    {
      "id": "end_ok",
      "type": "end",
      "label": "SUCCESS",
      "config": {
        "status": "success"
      },
      "ports": {
        "inputs": {
          "report": {
            "type": "string"
          }
        }
      }
    },
    {
      "id": "end_fail",
      "type": "end",
      "label": "FAILED",
      "config": {
        "status": "failed"
      },
      "ports": {
        "inputs": {
          "failures": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "gate_false": {
            "schema": {},
            "required": false
          }
        }
      }
    }
  ],
  "edges": [
    "start.request -> planner.request",
    "start.repository -> planner.repository",
    "planner.tasks -> fix_loop.tasks",
    "planner.acceptance_criteria -> fix_loop.acceptance_criteria",
    "planner.plan -> risk.plan",
    "planner.plan -> report.plan",
    "fix_loop.passed -> gate.value",
    "fix_loop.failures -> end_fail.failures",
    "fix_loop.iterations -> headline.iterations",
    "fix_loop.summary -> headline.summary",
    "headline.text -> report.headline",
    "risk.issues -> report.risks",
    "report.report -> end_ok.report",
    "gate.false -> end_fail.gate_false",
    "gate.true -> headline.gate_true"
  ]
}
