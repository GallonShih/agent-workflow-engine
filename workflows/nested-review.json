{
  "version": 1,
  "id": "nested-review",
  "name": "巢狀示範：subflow 拆解任務 → 外層 review 2 輪 × 內層 coding⇄testing 迴圈",
  "nodes": [
    {
      "id": "start",
      "type": "start",
      "ports": {
        "outputs": {
          "request": {
            "type": "string"
          },
          "repository": {
            "type": "string"
          }
        }
      }
    },
    {
      "id": "plan",
      "type": "subflow",
      "label": "子流程：plan-subflow",
      "config": {
        "workflow": "plan-subflow"
      },
      "ports": {
        "inputs": {
          "request": {
            "type": "string"
          },
          "repository": {
            "type": "string"
          }
        },
        "outputs": {
          "plan": {
            "type": "string"
          },
          "tasks": {
            "type": "array",
            "items": {
              "$type": "Task"
            }
          },
          "acceptance_criteria": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    {
      "id": "review_rounds",
      "type": "loop",
      "label": "外層：Review Rounds（2 輪）",
      "ports": {
        "inputs": {
          "tasks": {
            "type": "array",
            "items": {
              "$type": "Task"
            }
          },
          "acceptance_criteria": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "outputs": {
          "passed": {
            "type": "boolean"
          },
          "report": {
            "type": "string"
          },
          "inner_iterations": {
            "type": "integer"
          }
        }
      },
      "config": {
        "max_iterations": 2
      },
      "body": {
        "nodes": [
          {
            "id": "loop_in",
            "type": "loop_in"
          },
          {
            "id": "fix_loop",
            "type": "loop",
            "label": "內層：Coding ⇄ Testing",
            "ports": {
              "inputs": {
                "tasks": {
                  "type": "array",
                  "items": {
                    "$type": "Task"
                  }
                },
                "acceptance_criteria": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "feedback": {
                  "schema": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "required": false,
                  "default": []
                }
              },
              "outputs": {
                "passed": {
                  "type": "boolean"
                },
                "failures": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "summary": {
                  "type": "string"
                },
                "files_modified": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "report": {
                  "type": "string"
                },
                "feedback": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "config": {
              "max_iterations": 3,
              "until": {
                "port": "passed",
                "op": "eq",
                "value": true
              }
            },
            "body": {
              "nodes": [
                {
                  "id": "loop_in",
                  "type": "loop_in"
                },
                {
                  "id": "coder",
                  "type": "coding_agent",
                  "label": "Coding Agent"
                },
                {
                  "id": "tester",
                  "type": "testing_agent",
                  "label": "Testing Agent"
                },
                {
                  "id": "loop_out",
                  "type": "loop_out"
                }
              ],
              "edges": [
                "loop_in.tasks -> coder.tasks",
                "loop_in.feedback -> coder.feedback",
                "loop_in.acceptance_criteria -> tester.acceptance_criteria",
                "coder.files_modified -> tester.files_modified",
                "coder.files_modified -> loop_out.files_modified",
                "coder.summary -> loop_out.summary",
                "tester.passed -> loop_out.passed",
                "tester.failures -> loop_out.failures",
                "tester.report -> loop_out.report",
                "tester.failures -> loop_out.feedback"
              ]
            }
          },
          {
            "id": "note",
            "type": "log",
            "label": "記錄本輪結果",
            "config": {
              "level": "info"
            }
          },
          {
            "id": "loop_out",
            "type": "loop_out"
          }
        ],
        "edges": [
          "loop_in.tasks -> fix_loop.tasks",
          "loop_in.acceptance_criteria -> fix_loop.acceptance_criteria",
          "fix_loop.report -> note.message",
          "fix_loop.passed -> loop_out.passed",
          "fix_loop.report -> loop_out.report",
          "fix_loop.iterations -> loop_out.inner_iterations"
        ]
      }
    },
    {
      "id": "end_ok",
      "type": "end",
      "label": "SUCCESS",
      "config": {
        "status": "success"
      },
      "ports": {
        "inputs": {
          "report": {
            "type": "string"
          }
        }
      }
    }
  ],
  "edges": [
    "start.request -> plan.request",
    "start.repository -> plan.repository",
    "plan.tasks -> review_rounds.tasks",
    "plan.acceptance_criteria -> review_rounds.acceptance_criteria",
    "review_rounds.report -> end_ok.report"
  ]
}
